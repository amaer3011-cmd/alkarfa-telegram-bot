# Required Telegram credentials only
# API_ID and API_HASH: https://my.telegram.org
API_ID=123456
API_HASH=your_api_hash_here

# BOT_TOKEN: obtained from @BotFather
BOT_TOKEN=123456:your_bot_token_here

# Optional: comma-separated user ids allowed to manage channels
# (leave empty to allow everyone)
# ADMIN_IDS=111111111,222222222

# Owner(s) of the bot — ids allowed to open the admin panel (/admin).
# REQUIRED if you want the admin panel. Get your id from @userinfobot.
OWNER_IDS=111111111
# Time zone for dates shown in the panel (default Africa/Cairo)
# TIMEZONE=Africa/Cairo

# --- Video editing (optional, these are the defaults) ---
# ffmpeg must be installed (the Dockerfile installs it).
# MAX_CONCURRENT_ENCODES=1   # videos re-encoded at the same time (CPU heavy)
# VIDEO_PRESET=veryfast      # x264 speed: ultrafast..slow (slower = smaller file)
# VIDEO_CRF=23               # quality: lower = better but bigger (18-28)
# VIDEO_TIMEOUT=7200         # max seconds for one video
# FONT_PATH=/path/to/font.ttf  # font with Arabic support for watermark/title text
# FFMPEG_PATH=ffmpeg
